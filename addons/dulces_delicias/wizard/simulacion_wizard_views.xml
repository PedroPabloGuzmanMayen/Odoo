<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dd_simulacion_wizard_form" model="ir.ui.view">
        <field name="name">dd.simulacion.wizard.form</field>
        <field name="model">dd.simulacion.wizard</field>
        <field name="arch" type="xml">
            <form string="Simular caso de estudio">
                <div class="alert alert-info" role="alert" invisible="resultado">
                    Genera automáticamente las transacciones del caso de estudio (inventario inicial, compras,
                    producción, CRM, ventas, entregas, facturación, pagos y postventa) tal como se describen en la
                    guía técnica. Desmarque los pasos que desee realizar manualmente. Cada paso se ejecuta una sola vez.
                </div>
                <group invisible="resultado">
                    <field name="paso_inventario"/>
                    <field name="paso_compras"/>
                    <field name="paso_produccion"/>
                    <field name="paso_crm"/>
                    <field name="paso_ventas"/>
                    <field name="paso_entregas"/>
                    <field name="paso_facturacion"/>
                    <field name="paso_postventa"/>
                </group>
                <field name="resultado" invisible="not resultado"/>
                <footer>
                    <button name="action_ejecutar" type="object" string="Ejecutar simulación" class="btn-primary"
                            invisible="resultado"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dd_simulacion_wizard" model="ir.actions.act_window">
        <field name="name">Simular caso de estudio</field>
        <field name="res_model">dd.simulacion.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
