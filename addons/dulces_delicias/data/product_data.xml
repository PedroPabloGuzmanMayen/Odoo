        <field name="price">45.00</field>
        <field name="min_qty">10</field>
        <field name="delay">4</field>
    </record>
    <record id="sup_leche" model="product.supplierinfo">
        <field name="partner_id" ref="prov_lacteos"/>
        <field name="product_tmpl_id" ref="mp_leche_product_template"/>
        <field name="price">10.00</field>
        <field name="delay">1</field>
    </record>
    <record id="sup_mantequilla" model="product.supplierinfo">
        <field name="partner_id" ref="prov_lacteos"/>
        <field name="product_tmpl_id" ref="mp_mantequilla_product_template"/>
        <field name="price">40.00</field>
        <field name="delay">1</field>
    </record>
    <record id="sup_harina" model="product.supplierinfo">
        <field name="partner_id" ref="prov_harina"/>
        <field name="product_tmpl_id" ref="mp_harina_product_template"/>
        <field name="price">7.00</field>
        <field name="min_qty">50</field>
        <field name="delay">3</field>
    </record>
    <record id="sup_huevos" model="product.supplierinfo">
        <field name="partner_id" ref="prov_huevos"/>
